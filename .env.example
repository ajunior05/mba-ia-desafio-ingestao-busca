# Gemini (provider utilizado nesta solução)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL='models/gemini-embedding-001'
GOOGLE_CHAT_MODEL='gemini-3.5-flash-lite'

# OpenAI (não utilizado — mantido apenas por compatibilidade com o template)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'

# Banco de dados (PostgreSQL + pgVector via docker-compose)
DATABASE_URL='postgresql+psycopg://postgres:postgres@localhost:5432/rag'
PG_VECTOR_COLLECTION_NAME='documentos'

# Caminho do PDF (vazio = usa ./document.pdf na raiz do projeto)
PDF_PATH=
